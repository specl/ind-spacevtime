model{
  ## Contrast-coded factor model with the task scale estimated INSIDE the model.
  ## Notation follows the paper:
  ##   i = 1..I        individuals
  ##   j = 1..J        perception tasks (Task 1-6: TPi TLetter TGabor SPi SLetter SGabor)
  ##   q = 1..nCog     cognitive tasks (Task 7-10)
  ##   t = 1..nTask    all tasks, nTask = J + nCog
  ##   l = 1..L        perceptual factors, L = 4:  1 G  (average level of the six tasks, "good eye")
  ##                                               2 M  (Temporal minus Spatial: fast eye vs sharp eye)
  ##                                               3 S1 (Pi minus Letter)
  ##                                               4 S2 (Pi and Letter vs Gabor)
  ##   l = L+1         cognitive factor
  ##   gamma[i,]       = (theta_i', c_i')'  abilities on the ten tasks.  gamma[i,J+q] is DATA (the observed cognitive score c_iq),
  ##                   gamma[i,1:J] is estimated (data matrix: NA in the first J columns).
  ##   measurement:    gamma_i = mu + Lambda eta_i + epsilon_i,  epsilon_i ~ N(0, Delta)
  ##   structural:     eta_{L+1} = sum_l b_l eta_l + zeta,  zeta ~ N(0, 1)
  ##
  ## (1) MEASUREMENT.  The four perceptual factors are the orthogonal CONTRASTS of the 2 x 3 design (columns of `dsg`, passed as data):
  ##         dsg[,1] = 1                   G   the same weight on all six tasks
  ##         dsg[,2] = +1 (T) / -1 (S)     M   Temporal minus Spatial
  ##         dsg[,3:4] = Helmert contrasts S1, S2 of the three stimuli (orthonormal, orthogonal to the constant)
  ##     and every contrast has ONE loading:  Lambda[j,l] = omega[j] * dsg[j,l] * lamv[l],  lamv = (lamG, lamM, lamS, lamS).
  ##     S1 and S2 share lamS, so the stimulus part does not depend on how the Helmert contrasts are ordered.
  ##     Implied covariance of two perceptual tasks (m = masking, a = stimulus, s = +1/-1):
  ##         Cov(gamma_ma, gamma_m'a') = omega_j omega_j' [ lamG^2 + s_m s_m' lamM^2 + lamS^2 (1[a = a'] - 1/3) ] + 1[j = j'] delta2_j
  ## (2) TASK SCALE.  omega[j] = exp(la[j]), sum_j la[j] = 0 (geometric mean of the six omega = 1).  omega[j] is the SD of the common part of task j
  ##     relative to the geometric-mean task; lamG, lamM, lamS are in the units of that task.  omega multiplies G, M, S1 and S2 of task j alike, so
  ##     the RATIO general : masking : stimulus is the same for every task by construction; only the unique variance delta2[j] differs between tasks.
  ## (3) STRUCTURE.  b has FOUR elements, one per contrast: with the loading matrix above the four factors span the same space
  ##     as the four combinations of cell abilities that carry information, so all four b are identified and no extra constraint is needed.
  ##         b[1]  average level of the six tasks        b[2]  Temporal - Spatial
  ##         b[3]  Pi - Letter                           b[4]  (Pi + Letter)/2 - Gabor   (b[3], b[4] depend on the contrast order; only b[3]^2 + b[4]^2 does not)
  ##     The Masking x Stimulus interaction (2 df) stays in the unique part and is unrelated to the cognitive factor.

  ## ---- task scale ----
  for (j in 1:(J-1)){
    la[j] ~ dnorm(0, 1)}
  la[J] <- -sum(la[1:(J-1)])
  for (j in 1:J){
    omega[j] <- exp(la[j])}

  ## ---- structural level ----
  for (l in 1:L){
    b[l] ~ dnorm(0, 1)}
  for (i in 1:I){
    for (l in 1:(L+1)){
      zeta[i,l] ~ dnorm(0, 1)}
    for (l in 1:L){
      eta[i,l] <- zeta[i,l]}                                           # perceptual factors equal their residuals
    eta[i,L+1] <- inprod(b[1:L], eta[i,1:L]) + zeta[i,L+1]}            # cognitive factor

  ## ---- measurement level ----
  lamG ~ dnorm(0, 1) T(0,)                                             # one half-normal loading per contrast
  lamM ~ dnorm(0, 1) T(0,)
  lamS ~ dnorm(0, 1) T(0,)
  lamv[1] <- lamG
  lamv[2] <- lamM
  lamv[3] <- lamS
  lamv[4] <- lamS
  for (t in 1:nTask){
    mu[t] ~ dnorm(0, pow(5, -2))
    delta[t] ~ dt(0, pow(2.5, -2), 3) T(0,)                            # Half-t3(0, 2.5) on the unique SD
    delta2[t] <- pow(delta[t], 2)
    prec[t] <- 1 / delta2[t]}
  for (j in 1:J){
    for (l in 1:L){
      Lambda[j,l] <- omega[j] * dsg[j,l] * lamv[l]}
    Lambda[j,L+1] <- 0}
  for (q in 1:nCog){
    lamC[q] ~ dnorm(0, 1) T(0,)                                        # cognitive loadings, half-normal as in model.jags
    for (l in 1:L){
      Lambda[J+q,l] <- 0}
    Lambda[J+q,L+1] <- lamC[q]}

  for (i in 1:I){
    for (t in 1:nTask){
      gamma[i,t] ~ dnorm(mu[t] + inprod(Lambda[t,1:(L+1)], eta[i,1:(L+1)]), prec[t])}   # columns J+1..nTask are data (observed cognitive scores)
    for (j in 1:J){
      theta[i,j] <- gamma[i,j]}}                                       # perceptual abilities

  ## ---- data level: Bernoulli trials aggregated to binomial counts ----
  for (j in 1:J){
    beta[j] ~ dnorm(0, pow(5, -2))}
  for (n in 1:N){
    p[n] <- eps + (1 - 2*eps) * phi(beta[task[n]] * (s[n] + theta[id[n], task[n]]))     # eps = 1e-6: numerical guard so that p is never exactly 0 or 1
    y[n] ~ dbin(p[n], nTrial[n])}

  ## ---- derived: variance decomposition of the perception tasks (Table 1) ----
  com <- pow(lamG, 2) + pow(lamM, 2) + (2/3) * pow(lamS, 2)            # common variance of a task / omega^2
  ratio_gen  <- pow(lamG, 2) / com                                     # general : masking : stimulus, the SAME for every task
  ratio_mask <- pow(lamM, 2) / com
  ratio_stim <- (2/3) * pow(lamS, 2) / com
  for (j in 1:J){
    tot[j] <- inprod(Lambda[j,1:L], Lambda[j,1:L]) + delta2[j]
    share_gen[j]  <- pow(Lambda[j,1], 2) / tot[j]
    share_mask[j] <- pow(Lambda[j,2], 2) / tot[j]
    share_stim[j] <- (pow(Lambda[j,3], 2) + pow(Lambda[j,4], 2)) / tot[j]
    share_uni[j]  <- delta2[j] / tot[j]
    sdTheta[j]    <- sqrt(tot[j])}                                     # SD of theta_j across people

  ## ---- derived: correlation of each contrast factor with the cognitive factor, and variance of it explained (Table 2) ----
  varEta <- inprod(b[1:L], b[1:L]) + 1                              # Var(eta_{L+1})
  for (l in 1:L){
    r[l] <- b[l] / sqrt(varEta)}
  R2_G <- pow(b[1], 2) / varEta
  R2_M <- pow(b[2], 2) / varEta
  R2_S <- (pow(b[3], 2) + pow(b[4], 2)) / varEta

  ## ---- derived: composite abilities (true part of the mean of the tasks in a margin) and their correlation with the cognitive factor ----
  ##   fast = mean of the three Temporal tasks = lamG eta_G + lamM eta_M,   sharp = lamG eta_G - lamM eta_M,
  ##   stimulus a = mean of the two tasks with stimulus a = lamG eta_G + lamS (H[a,1] eta_S1 + H[a,2] eta_S2)   (hs[a,] = Helmert row, data)
  ##   These do not depend on the coding convention.  omega cancels in the correlations.
  r_fast_sharp <- (pow(lamG, 2) - pow(lamM, 2)) / (pow(lamG, 2) + pow(lamM, 2))
  r_comp[1] <- (lamG * b[1] + lamM * b[2]) / sqrt((pow(lamG, 2) + pow(lamM, 2)) * varEta)          # fast eye
  r_comp[2] <- (lamG * b[1] - lamM * b[2]) / sqrt((pow(lamG, 2) + pow(lamM, 2)) * varEta)          # sharp eye
  for (a in 1:3){
    r_comp[2+a] <- (lamG * b[1] + lamS * (hs[a,1] * b[3] + hs[a,2] * b[4])) /
                   sqrt((pow(lamG, 2) + pow(lamS, 2) * (pow(hs[a,1], 2) + pow(hs[a,2], 2))) * varEta)}  # Pi, Letter, Gabor

  ## ---- derived: model-implied covariance, Sigma = Lambda Q Q' Lambda' + Delta, Q = (I - B)^-1 = I + B ----
  for (l in 1:L){
    for (l2 in 1:(L+1)){
      B[l,l2] <- 0}}
  for (l in 1:L){
    B[L+1,l] <- b[l]}
  B[L+1,L+1] <- 0
  # B has only its last row free, so B %*% B = 0 and Q = (I - B)^-1 = I + B exactly
  # (JAGS inverse() requires a symmetric positive definite matrix, so it cannot be used here)
  for (l in 1:(L+1)){
    for (l2 in 1:(L+1)){
      Q[l,l2] <- equals(l,l2) + B[l,l2]}}
  LQ[1:nTask,1:(L+1)] <- Lambda[1:nTask,1:(L+1)] %*% Q[1:(L+1),1:(L+1)]
  for (t in 1:nTask){
    for (t2 in 1:nTask){
      Sigma[t,t2] <- inprod(LQ[t,1:(L+1)], LQ[t2,1:(L+1)]) + equals(t,t2) * delta2[t]}}
}
