\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Trial sequence of the temporal-masking tasks. Panels A-C show the Pi, Letter, and Gabor tasks. After a fixation cross (485 ms) and the target, a variable stimulus onset asynchrony (SOA) elapsed before the target was replaced by five masks (48.5 ms each): line segments (Pi), frequency-matched letter noise (Letter), or white noise (Gabor). Participants judged which leg of the Pi was longer, which of nine letters (A-L) was shown, or whether the Gabor was tilted left or right. Difficulty was adjusted by varying the SOA.}}{37}{figure.caption.25}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:temporal}{{1}{37}{Trial sequence of the temporal-masking tasks. Panels A-C show the Pi, Letter, and Gabor tasks. After a fixation cross (485 ms) and the target, a variable stimulus onset asynchrony (SOA) elapsed before the target was replaced by five masks (48.5 ms each): line segments (Pi), frequency-matched letter noise (Letter), or white noise (Gabor). Participants judged which leg of the Pi was longer, which of nine letters (A-L) was shown, or whether the Gabor was tilted left or right. Difficulty was adjusted by varying the SOA}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Trial sequence of the spatial-masking tasks. Panels A-C show the Pi, Letter, and Gabor tasks. After a fixation cross (485 ms), the target was presented together with the same mask as in the temporal-masking tasks (485 ms). Participants made the same judgments. Difficulty was adjusted by varying the leg-length difference (Pi), the target weight in the letter-noise blend (Letter), or the contrast (Gabor).}}{38}{figure.caption.26}\protected@file@percent }
\newlabel{fig:spatial}{{2}{38}{Trial sequence of the spatial-masking tasks. Panels A-C show the Pi, Letter, and Gabor tasks. After a fixation cross (485 ms), the target was presented together with the same mask as in the temporal-masking tasks (485 ms). Participants made the same judgments. Difficulty was adjusted by varying the leg-length difference (Pi), the target weight in the letter-noise blend (Letter), or the contrast (Gabor)}{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Leverage of one outlying individual (red) on task correlations. Each panel plots two perceptual tasks against each other. Lines are least-squares fits with (solid) and without (dashed) the outlier. The outlier changes the correlation little in Panel A but substantially in Panel B.}}{39}{figure.caption.27}\protected@file@percent }
\newlabel{fig:leverage}{{3}{39}{Leverage of one outlying individual (red) on task correlations. Each panel plots two perceptual tasks against each other. Lines are least-squares fits with (solid) and without (dashed) the outlier. The outlier changes the correlation little in Panel A but substantially in Panel B}{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Observed correlations among the 10 tasks, computed from each individual's summary scores. (A) Correlation matrix of the six perceptual tasks and four cognitive tasks, with score histograms on the diagonal and scatterplots above it. (B) Correlations between each perceptual task and each cognitive task, shown separately for temporal-masking and spatial-masking tasks, with the mean correlation for each. (C) Hierarchical clustering of the 10 tasks.}}{40}{figure.caption.28}\protected@file@percent }
\newlabel{fig:summary}{{4}{40}{Observed correlations among the 10 tasks, computed from each individual's summary scores. (A) Correlation matrix of the six perceptual tasks and four cognitive tasks, with score histograms on the diagonal and scatterplots above it. (B) Correlations between each perceptual task and each cognitive task, shown separately for temporal-masking and spatial-masking tasks, with the mean correlation for each. (C) Hierarchical clustering of the 10 tasks}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Model-implied correlations among the 10 tasks, based on the posterior of the hierarchical model. (A) Posterior mean correlation matrix of the six perceptual tasks and four cognitive tasks, with score histograms on the diagonal and scatterplots above it. (B) Model-implied correlations between each perceptual task and each cognitive task, shown separately for temporal-masking and spatial-masking tasks, with the mean correlation for each. (C) Hierarchical clustering of the 10 tasks based on the model-implied correlations.}}{41}{figure.caption.29}\protected@file@percent }
\newlabel{fig:sem}{{5}{41}{Model-implied correlations among the 10 tasks, based on the posterior of the hierarchical model. (A) Posterior mean correlation matrix of the six perceptual tasks and four cognitive tasks, with score histograms on the diagonal and scatterplots above it. (B) Model-implied correlations between each perceptual task and each cognitive task, shown separately for temporal-masking and spatial-masking tasks, with the mean correlation for each. (C) Hierarchical clustering of the 10 tasks based on the model-implied correlations}{figure.caption.29}{}}
