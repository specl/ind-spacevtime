\begin{figure*}[hbt]
\ifnextchar[{\eatarg}{}

\includegraphics[width=1\linewidth]{Figures/temporal} \caption{Trial sequence of the temporal-masking tasks. Panels A-C show the Pi, Letter, and Gabor tasks. After a fixation cross (485 ms) and the target, a variable stimulus onset asynchrony (SOA) elapsed before the target was replaced by five masks (48.5 ms each): line segments (Pi), frequency-matched letter noise (Letter), or white noise (Gabor). Participants judged which leg of the Pi was longer, which of nine letters (A-L) was shown, or whether the Gabor was tilted left or right. Difficulty was adjusted by varying the SOA.}\label{fig:temporal}
\end{figure*}
\begin{figure*}[hbt]
\ifnextchar[{\eatarg}{}

\includegraphics[width=1\linewidth]{Figures/spatial} \caption{Trial sequence of the spatial-masking tasks. Panels A-C show the Pi, Letter, and Gabor tasks. After a fixation cross (485 ms), the target was presented together with the same mask as in the temporal-masking tasks (485 ms). Participants made the same judgments. Difficulty was adjusted by varying the leg-length difference (Pi), the target weight in the letter-noise blend (Letter), or the contrast (Gabor).}\label{fig:spatial}
\end{figure*}
\begin{figure*}[hbt]
\ifnextchar[{\eatarg}{}

\includegraphics[width=1\linewidth]{Figures/leverage} \caption{Leverage of one outlying individual (red) on task correlations. Each panel plots two perceptual tasks against each other. Lines are least-squares fits with (solid) and without (dashed) the outlier. The outlier changes the correlation little in Panel A but substantially in Panel B.}\label{fig:leverage}
\end{figure*}
\begin{figure*}[hbt]
\ifnextchar[{\eatarg}{}

\includegraphics[width=1\linewidth]{Figures/summary} \caption{Observed correlations among the 10 tasks, computed from each individual's summary scores. (A) Correlation matrix of the six perceptual tasks and four cognitive tasks, with score histograms on the diagonal and scatterplots above it. (B) Correlations between each perceptual task and each cognitive task, shown separately for temporal-masking and spatial-masking tasks, with the mean correlation for each. (C) Hierarchical clustering of the 10 tasks.}\label{fig:summary}
\end{figure*}
\begin{figure*}[hbt]
\ifnextchar[{\eatarg}{}


{\centering \includegraphics[width=1\linewidth]{Figures/sem}

}

\caption{Model-implied correlations among the 10 tasks, based on the posterior of the hierarchical model. (A) Posterior mean correlation matrix of the six perceptual tasks and four cognitive tasks,  with score histograms on the diagonal and scatterplots above it. (B) Model-implied correlations between each perceptual task and each cognitive task, shown separately for temporal-masking and spatial-masking tasks, with the mean correlation for each. (C) Hierarchical clustering of the 10 tasks based on the model-implied correlations.}\label{fig:sem}
\end{figure*}
